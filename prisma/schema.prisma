generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Propietario: control total. Admin: gestión amplia y usuarios (sin crear propietarios ni admins).
/// OPS_ADMIN: todo salvo usuarios. FIELD: clientes, órdenes (estado), agenda (lectura).
enum CompanyRole {
  OWNER
  ADMIN
  OPS_ADMIN
  FIELD
}

/// Clasificación opcional para líneas de cotización: mano de obra vs material.
enum ServiceItemType {
  SERVICIO
  PRODUCTO
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum QuoteDiscountMode {
  NONE
  PERCENT
  FIXED
}

/// Campos extra configurables por empresa en el formulario de cotización.
enum QuotationCustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  CARD
  OTHER
}

/// Persona natural vs empresa u organismo.
enum ClientKind {
  PERSON
  ORGANIZATION
}

enum AgendaEventSource {
  MANUAL
  QUOTATION
}

enum AgendaAttendanceStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Pendiente de confirmación del trabajador; SIGNED tras “firmar” (botón / futura firma electrónica).
enum PaymentStatus {
  PENDING_SIGNATURE
  SIGNED
}

model User {
  id        String   @id @default(cuid())
  /// Obligatorio en la app; histórico puede venir de migración desde el correo.
  name      String
  email     String   @unique
  password  String?
  /// RUT chileno (ej. 12.345.678-5 o 12345678-5), validado en servidor.
  rut       String?
  /// Teléfono de contacto
  phone     String?
  /// Dirección
  address   String?  @db.Text
  bankName           String?
  bankAccountType    String?
  bankAccountNumber  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships           CompanyMember[]
  paymentsAsWorker      Payment[]       @relation("PaymentWorker")
  paymentsRecorded      Payment[]       @relation("PaymentRecordedBy")
  paymentsSigned        Payment[]       @relation("PaymentSignedBy")
  documentsUploaded     CompanyDocument[]
  foldersCreated        CompanyDocumentFolder[] @relation("FolderCreator")
  agendaEventsCreated   AgendaEvent[]           @relation("AgendaEventCreator")
  agendaAttendances     AgendaAttendance[]
}

/// Carpeta lógica; permisos por carpeta (autor + banderas, como documentos) + matriz por rol.
model CompanyDocumentFolder {
  id        String   @id @default(cuid())
  companyId String
  parentId  String?
  name      String
  createdByUserId String
  /// Si es false, solo el autor y la gerencia ven la carpeta en el explorador.
  othersCanView   Boolean  @default(true)
  /// Si es false, solo el autor o el propietario renombran/mueven la carpeta.
  othersCanEdit   Boolean  @default(true)
  /// Si es false, solo el autor o el propietario eliminan la carpeta vacía.
  othersCanDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent    CompanyDocumentFolder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  CompanyDocumentFolder[]  @relation("FolderTree")
  documents CompanyDocument[]
  createdBy User                     @relation("FolderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([companyId, parentId])
}

/// Archivo de empresa en Cloudflare R2; visibilidad y edición/baja se combinan con la matriz de permisos.
model CompanyDocument {
  id                 String   @id @default(cuid())
  companyId          String
  uploadedByUserId   String
  folderId           String?
  /// Título mostrado; si null se usa el nombre del archivo.
  title              String?
  originalFilename   String
  storageKey         String   @unique
  mimeType           String
  sizeBytes          Int
  /// Si es false, solo el autor y la gerencia (propietario/admin) ven el documento.
  othersCanView      Boolean  @default(true)
  /// Si es false, solo quien subió el archivo o el propietario pueden cambiar metadatos (nombre, banderas).
  othersCanEdit      Boolean  @default(true)
  /// Si es false, solo quien subió o el propietario pueden eliminar (además de la matriz cuando aplica).
  othersCanDelete    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company    Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User                    @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  folder     CompanyDocumentFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([companyId, uploadedByUserId])
  @@index([companyId, folderId])
}

/// Cada empresa aísla sus propios registros (multi-tenant).
model Company {
  id        String   @id @default(cuid())
  name      String
  /// Identificador único legible para URLs / API
  slug      String   @unique
  /// Prefijo para N° de cotización (ej. COT → COT-00001)
  quoteCodePrefix   String   @default("COT")
  /// Ancho del número (relleno con ceros)
  quoteCodePadding  Int      @default(5)
  lastQuoteSequence Int      @default(0)
  /// Permisos por rol y módulo (lectura/alta/edición/baja). null = valores por defecto de la app.
  rolePermissions   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members    CompanyMember[]
  services   Service[]
  quotations Quotation[]
  payments   Payment[]
  documents  CompanyDocument[]
  documentFolders CompanyDocumentFolder[]
  clients    CompanyClient[]
  agendaEvents AgendaEvent[]
  quotationCustomFields QuotationCustomField[]
}

/// Cliente de la empresa (persona u organización); usado en cotizaciones y CRM.
model CompanyClient {
  id        String     @id @default(cuid())
  companyId String
  kind      ClientKind
  /// Nombre completo (persona) o nombre comercial / razón social (organización).
  name      String
  /// Opcional; se puede completar después.
  email     String?
  phone     String?
  rut       String?
  notes     String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotations Quotation[]

  @@index([companyId])
  @@index([companyId, name])
}

/// Ítem de catálogo por empresa (líneas típicas al armar cotizaciones).
model Service {
  id           String           @id @default(cuid())
  companyId    String
  name         String
  description  String?          @db.Text
  itemType     ServiceItemType?
  defaultPrice Decimal?         @db.Decimal(12, 2)
  unit         String?
  sortOrder    Int              @default(0)
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotationLines QuotationLine[]

  @@index([companyId])
}

model Quotation {
  id             String            @id @default(cuid())
  companyId      String
  /// Opcional: cotizaciones antiguas sin vínculo; las nuevas guardan cliente asociado.
  clientId       String?
  quoteNumber    String
  sequence       Int
  serviceDate    DateTime
  /// Copia al emitir la cotización (histórico en PDF aunque cambie la ficha del cliente).
  clientName     String
  clientEmail    String?
  clientPhone    String?
  discountMode   QuoteDiscountMode @default(NONE)
  /// Si PERCENT: 0–100. Si FIXED: monto en moneda. Si NONE: null.
  discountValue  Decimal?          @db.Decimal(12, 2)
  subtotal       Decimal           @db.Decimal(12, 2)
  discountAmount Decimal           @db.Decimal(12, 2)
  total          Decimal           @db.Decimal(12, 2)
  status         QuotationStatus   @default(DRAFT)
  /// true cuando el PDF se envió por correo al menos una vez (Resend).
  emailSent      Boolean           @default(false)
  /// Fecha/hora del último envío por correo; null si nunca se envió.
  emailSentAt    DateTime?
  /// Valores por id de `QuotationCustomField` (JSON objeto plano).
  customFieldValues Json              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client         CompanyClient?    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lines          QuotationLine[]
  agendaEvent    AgendaEvent?

  @@unique([companyId, quoteNumber])
  @@index([companyId])
  @@index([clientId])
}

/// Definición de campo personalizado por empresa (aparece al crear cotizaciones).
model QuotationCustomField {
  id         String                   @id @default(cuid())
  companyId  String
  /// Clave estable en exportaciones / integraciones (minúsculas, números, guión bajo).
  key        String
  label      String
  fieldType  QuotationCustomFieldType @default(TEXT)
  required   Boolean                  @default(false)
  sortOrder  Int                      @default(0)
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  company    Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId, sortOrder])
}

/// Líneas con snapshot: cambiar aquí no altera el catálogo Service.
model QuotationLine {
  id            String           @id @default(cuid())
  quotationId   String
  serviceId     String?
  name          String
  description   String?          @db.Text
  itemType      ServiceItemType?
  unitPrice     Decimal          @db.Decimal(12, 2)
  quantity      Decimal          @db.Decimal(12, 4)
  lineTotal     Decimal          @db.Decimal(12, 2)
  sortOrder     Int              @default(0)
  quotation     Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  service       Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([quotationId])
}

/// Evento de agenda (manual o generado al aceptar una cotización).
model AgendaEvent {
  id              String             @id @default(cuid())
  companyId       String
  title           String
  description     String?            @db.Text
  location        String?
  startAt         DateTime
  endAt           DateTime
  source          AgendaEventSource  @default(MANUAL)
  quotationId     String?            @unique
  createdByUserId String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  User               @relation("AgendaEventCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  quotation  Quotation?         @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  attendees  AgendaAttendance[]

  @@index([companyId, startAt])
}

model AgendaAttendance {
  id          String                   @id @default(cuid())
  eventId     String
  userId      String
  status      AgendaAttendanceStatus   @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime                 @default(now())

  event AgendaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

/// Pago a un trabajador de la empresa (miembro registrado). El beneficiario puede ver y firmar.
model Payment {
  id                    String         @id @default(cuid())
  companyId             String
  /// Usuario beneficiario (debe ser miembro de la empresa).
  workerUserId          String
  /// Quien registró el pago en el sistema.
  recordedByUserId      String
  paymentMethod         PaymentMethod
  /// Fecha del servicio si aplica trabajo puntual; opcional.
  serviceDate           DateTime?
  activityDescription   String         @db.Text
  amount                Decimal        @db.Decimal(12, 2)
  tip                   Decimal        @default(0) @db.Decimal(12, 2)
  total                 Decimal        @db.Decimal(12, 2)
  transactionCode       String?
  status                PaymentStatus  @default(PENDING_SIGNATURE)
  signedAt              DateTime?
  signedByUserId        String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker     User    @relation("PaymentWorker", fields: [workerUserId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  signedBy   User?   @relation("PaymentSignedBy", fields: [signedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([workerUserId])
  @@index([companyId, status])
}

model CompanyMember {
  id        String       @id @default(cuid())
  userId    String
  companyId String
  role      CompanyRole  @default(FIELD)
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}
